"""Mimic data-generation config for {{ class_prefix }} — auto-generated by create_task.py.

Mixes the task cfg with isaaclab's :class:`MimicEnvCfg`, which adds the
``datagen_config`` and ``subtask_configs`` fields consumed by the Mimic data
generation pipeline. The generated ``{{ mimic_task_id }}`` gym id (see this
package's ``__init__.py``) wires this cfg to ``BaseILEnv``.

The generator emits this file with ``datagen_config`` left at its
:class:`DataGenConfig` defaults and ``subtask_configs`` empty. Edit this file
to set ``datagen_config`` fields (e.g. ``name``, ``generation_num_trials``,
``seed``) and to populate ``self.subtask_configs[<eef_name>]`` with the
per-EEF ``SubTaskConfig`` list once the matching subtask termination signals
exist on the task cfg.
"""

from isaaclab.envs.mimic_env_cfg import MimicEnvCfg
from isaaclab.utils import configclass

from .{{ task_name }}_cfg import {{ class_prefix }}TaskCfg


@configclass
class {{ class_prefix }}MimicEnvCfg({{ class_prefix }}TaskCfg, MimicEnvCfg):
    """Mimic-enabled configuration for {{ class_prefix }}."""

    def __post_init__(self):
        # Run both parents' post-inits first so all task scaffolding (scene,
        # actions, observations, eef_names → recorders) is in place.
        super().__post_init__()

        # ── datagen_config ────────────────────────────────────────────────
        # Override DataGenConfig defaults as needed, e.g.:
        #     self.datagen_config.name = "demo_src_{{ task_name }}_D0"
        #     self.datagen_config.generation_num_trials = 1000
        #     self.datagen_config.seed = 1

        # ── subtask_configs (per end-effector) ────────────────────────────
        # Populate once the matching subtask termination signals are wired
        # into the task cfg, e.g.:
        #     from isaaclab.envs.mimic_env_cfg import SubTaskConfig
        #     self.subtask_configs["gripper"] = [
        #         SubTaskConfig(object_ref="...", subtask_term_signal="..."),
        #         ...
        #     ]
