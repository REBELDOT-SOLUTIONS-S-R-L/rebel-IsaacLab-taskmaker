def _apply_rigid_apis(
    prim_path: str,
    cfg: UsdFileCfg,
    translation: tuple[float, float, float] | None = None,
    orientation: tuple[float, float, float, float] | None = None,
    **kwargs,
):
    """Spawn a USD and explicitly apply rigid-body / mass / collision APIs to its root prim."""
    rigid_props = cfg.rigid_props or sim_utils.RigidBodyPropertiesCfg()
    mass_props = cfg.mass_props or sim_utils.MassPropertiesCfg(mass=0.05)
    collision_props = cfg.collision_props or sim_utils.CollisionPropertiesCfg()

    cfg.rigid_props = None
    cfg.mass_props = None
    cfg.collision_props = None
    try:
        prim = sim_utils.spawn_from_usd(prim_path, cfg, translation=translation, orientation=orientation, **kwargs)
    finally:
        cfg.rigid_props = rigid_props
        cfg.mass_props = mass_props
        cfg.collision_props = collision_props

    sim_utils.define_rigid_body_properties(prim_path, rigid_props)
    sim_utils.define_mass_properties(prim_path, mass_props)
    sim_utils.define_collision_properties(prim_path, collision_props)
{% if has_physics_materials %}

    # Apply per-object physics material (friction / restitution overrides).
    leaf = prim_path.rstrip("/").rsplit("/", 1)[-1]
    mat_cfg = _PHYSICS_MATERIALS.get(leaf)
    if mat_cfg is not None:
        mat_path = f"{prim_path}/physicsMaterial"
        mat_cfg.func(mat_path, mat_cfg)
        sim_utils.bind_physics_material(prim_path, mat_path)
{% endif %}
    return prim

{% if has_baked_collision_objects %}
@sim_utils.clone
def spawn_rigid_usd(
    prim_path: str,
    cfg: UsdFileCfg,
    translation: tuple[float, float, float] | None = None,
    orientation: tuple[float, float, float, float] | None = None,
    **kwargs,
):
    """Spawn USD as a rigid body; preserve the collision approximation baked into the USD."""
    return _apply_rigid_apis(prim_path, cfg, translation, orientation, **kwargs)

{% endif %}
{% if has_sdf_objects %}
@sim_utils.clone
def spawn_rigid_usd_sdf(
    prim_path: str,
    cfg: UsdFileCfg,
    translation: tuple[float, float, float] | None = None,
    orientation: tuple[float, float, float, float] | None = None,
    **kwargs,
):
    """Spawn USD as a rigid body and override its collision approximation with SDF."""
    prim = _apply_rigid_apis(prim_path, cfg, translation, orientation, **kwargs)
    sim_utils.define_mesh_collision_properties(prim_path, sim_utils.SDFMeshPropertiesCfg())
    return prim

