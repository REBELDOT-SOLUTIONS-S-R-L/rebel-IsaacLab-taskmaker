@configclass
class {{ class_prefix }}TaskCfg(BaseILEnvCfg):

    scene: {{ class_prefix }}SceneCfg = {{ class_prefix }}SceneCfg(
        num_envs=1, env_spacing={{ env_spacing }}, replicate_physics=True
    )
    observations: {{ class_prefix }}ObservationsCfg = {{ class_prefix }}ObservationsCfg()
    actions: {{ class_prefix }}ActionsCfg = {{ class_prefix }}ActionsCfg()
    events: {{ class_prefix }}EventCfg = {{ class_prefix }}EventCfg()
    terminations: {{ class_prefix }}TerminationsCfg = {{ class_prefix }}TerminationsCfg()

{% if controller_type == "pink_ik" %}
    xr: XrCfg = XrCfg(
        anchor_pos=({{ teleop.xr_anchor_pos }}),
        anchor_rot=({{ teleop.xr_anchor_rot }}),
    )

    NUM_OPENXR_HAND_JOINTS = 26

{% endif %}
    def __post_init__(self):
{% if eef.names %}
        # EEF list — picked up by BaseILEnv methods and wired into the
        # recorder's entity_order by BaseILEnvCfg.__post_init__. Set before
        # super() so the base post-init sees it.
        self.eef_names = {{ eef.names | pylist }}
{% endif %}
{% if eef_slices %}

        # Per-EEF action tensor layout — read by BaseILEnv to slice the action
        # tensor produced by the {{ controller_type }} controller back into per-arm poses.
        self.eef_action_slices = {
{% for name, slc in eef_slices.action.items() %}
            "{{ name }}": {"pos": ({{ slc.pos[0] }}, {{ slc.pos[1] }}), "quat": ({{ slc.quat[0] }}, {{ slc.quat[1] }})},
{% endfor %}
        }
{% if eef_slices.gripper_mode == "contiguous" %}

        # Contiguous gripper index ranges per EEF.
        self.eef_gripper_slices = {
{% for name, slc in eef_slices.gripper.items() %}
            "{{ name }}": ({{ slc[0] }}, {{ slc[1] }}),
{% endfor %}
        }
{% elif eef_slices.gripper_mode == "prefix" %}

        # Per-arm finger-joint column indices. Interleaved-hand layouts (e.g.
        # Inspire) split L/R fingers across `hand_joint_names`, so each arm's
        # gripper slice is a *list of indices* rather than a contiguous range.
        # Derived from the actual joint name order so reordering the YAML
        # `hand_joint_names` stays correct.
        _pose_offset = {{ eef_slices.pose_offset }}  # {{ eef_slices.num_eefs }} frame tasks * (3 + 4)
        _hand_names = self.actions.pink_ik_cfg.hand_joint_names
        self.eef_gripper_slices = {
{% for name, prefix in eef_slices.prefixes.items() %}
            "{{ name }}": [_pose_offset + i for i, n in enumerate(_hand_names) if n.startswith("{{ prefix }}")],
{% endfor %}
        }
{% elif eef_slices.gripper_mode == "contiguous_fallback" %}

        # TODO: declare `eef.hand_joint_prefixes` in the YAML so the generator
        # can produce a robust per-arm gripper slice. The values below assume an
        # even contiguous split, which only works if `hand_joint_names` is
        # ordered [arm-0 joints..., arm-1 joints..., ...].
        self.eef_gripper_slices = {
{% for name, slc in eef_slices.gripper.items() %}
            "{{ name }}": ({{ slc[0] }}, {{ slc[1] }}),
{% endfor %}
        }
{% endif %}
{% endif %}

        super().__post_init__()

        # Sim defaults from the task YAML (override BaseILEnvCfg defaults).
        self.decimation = {{ sim.decimation }}
        self.episode_length_s = {{ sim.episode_length_s }}
        self.sim.dt = {{ sim.dt }}
        self.sim.render_interval = {{ sim.render_interval }}
{% if cameras %}

        # Cameras — attached to robot links. Under XR teleop, IsaacLab's
        # `remove_camera_configs` strips these before scene build; the
        # `xr_camera_reattach` hook lets the teleop script put them back
        # before `gym.make` runs.
        attach_cameras(self.scene)
        self.xr_camera_reattach = attach_cameras
{% endif %}
{% if controller_type == "pink_ik" %}

        # Convert USD to URDF for Pink IK
        temp_urdf_output_path, temp_urdf_meshes_output_path = ControllerUtils.convert_usd_to_urdf(
            self.scene.robot.spawn.usd_path, self.temp_urdf_dir, force_conversion=True
        )
        self.actions.pink_ik_cfg.controller.urdf_path = temp_urdf_output_path
        self.actions.pink_ik_cfg.controller.mesh_path = temp_urdf_meshes_output_path

        # Teleop devices
        self.teleop_devices = DevicesCfg(
            devices={
                "{{ teleop.device }}": OpenXRDeviceCfg(
                    retargeters=[
                        {{ teleop.retargeter_class }}(
                            enable_visualization=True,
                            num_open_xr_hand_joints=2 * self.NUM_OPENXR_HAND_JOINTS,
                            sim_device=self.sim.device,
                            hand_joint_names=self.actions.pink_ik_cfg.hand_joint_names,
                        ),
                    ],
                    sim_device=self.sim.device,
