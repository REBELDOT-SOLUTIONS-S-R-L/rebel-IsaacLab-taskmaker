@configclass
class {{ class_prefix }}ObservationsCfg:
    """Observations for {{ class_prefix }}."""

    @configclass
    class PolicyCfg(ObsGroup):
        actions = ObsTerm(func=mdp.last_action)
        robot_joint_pos = ObsTerm(
            func=base_mdp.joint_pos,
            params={"asset_cfg": SceneEntityCfg("robot")},
        )
{% if observations.eef_link_names %}
        # End-effector pose observations.
        # `BaseILEnv.get_robot_eef_pose` reads these out of obs_buf by the
        # `{eef_name}_eef_pos` / `{eef_name}_eef_quat` keys — names must match.
{% for eef_name, link_name in observations.eef_link_names.items() %}
        {{ eef_name }}_eef_pos = ObsTerm(func=mdp.get_eef_pos, params={"link_name": "{{ link_name }}"})
        {{ eef_name }}_eef_quat = ObsTerm(func=mdp.get_eef_quat, params={"link_name": "{{ link_name }}"})
{% endfor %}
{% endif %}

        def __post_init__(self):
            self.enable_corruption = False
            self.concatenate_terms = False

{% if subtask_terms.signals %}
    @configclass
    class SubtaskTermsCfg(ObsGroup):
        """Subtask termination signals consumed by the annotated-teleop recorder.

        Each term returns a ``(num_envs, 1)`` binary float tensor that is ``1.0``
        when the corresponding subtask is complete. ``BaseILEnv.get_subtask_term_predicates``
        reads this group out of ``obs_buf["subtask_terms"]`` and feeds it to the
        recorder's dwell-and-latch logic. The attribute names below must match
        the ``subtask_term_signal`` values declared in
        ``{{ task_name }}_mimic_cfg.py``.
        """

{% for sig in subtask_terms.signals %}
{% if sig.params | length > 1 %}
        {{ sig.name }} = ObsTerm(
            func=mdp.{{ sig.func }},
            params={
{% for k, v in sig.params %}
                "{{ k }}": {{ v }},
{% endfor %}
            },
        )
{% else %}
        {{ sig.name }} = ObsTerm(func=mdp.{{ sig.func }}, params={"signal_name": "{{ sig.name }}"})
{% endif %}
{% endfor %}

        def __post_init__(self):
            self.enable_corruption = False
            self.concatenate_terms = False

{% endif %}
    policy: PolicyCfg = PolicyCfg()
{% if subtask_terms.signals %}
    subtask_terms: SubtaskTermsCfg = SubtaskTermsCfg()
{% endif %}


