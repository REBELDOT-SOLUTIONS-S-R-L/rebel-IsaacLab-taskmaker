class {{ class_prefix }}ObservationsCfg:
    """Observations for {{ class_prefix }}."""

    @configclass
    class PolicyCfg(ObsGroup):
        actions = ObsTerm(func=mdp.last_action)
        robot_joint_pos = ObsTerm(
            func=base_mdp.joint_pos,
            params={"asset_cfg": SceneEntityCfg("{{ robot.name }}")},
        )
{% if observations.eef_link_names %}
        # End-effector pose observations.
        # `BaseILEnv.get_robot_eef_pose` reads these out of obs_buf by the
        # `{eef_name}_eef_pos` / `{eef_name}_eef_quat` keys — names must match.
{% for eef_name, link_name in observations.eef_link_names.items() %}
        {{ eef_name }}_eef_pos = ObsTerm(func=mdp.get_eef_pos, params={"link_name": "{{ link_name }}"})
        {{ eef_name }}_eef_quat = ObsTerm(func=mdp.get_eef_quat, params={"link_name": "{{ link_name }}"})
{% endfor %}
{% endif %}

        def __post_init__(self):
            self.enable_corruption = False
            self.concatenate_terms = False

    policy: PolicyCfg = PolicyCfg()


