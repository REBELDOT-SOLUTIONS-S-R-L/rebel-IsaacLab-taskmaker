def _add_virtual_eef_links_to_stage(robot_prim_path: str) -> None:
    """Add task-local fixed EEF links to a spawned robot prim."""
    from pxr import Gf, Sdf, UsdGeom, UsdPhysics

    stage = sim_utils.get_current_stage()

    for link in _VIRTUAL_EEF_LINKS:
        parent_suffix = link["usd_parent_path"].removeprefix("/Robot")
        parent_sdf_path = Sdf.Path(f"{robot_prim_path}{parent_suffix}")
        parent_prim = stage.GetPrimAtPath(parent_sdf_path)
        if not parent_prim.IsValid():
            raise RuntimeError(
                f"Cannot add '{link['link_name']}': USD parent prim does not exist at '{parent_sdf_path}'."
            )

        offset = link["offset"]
        eef_path = parent_sdf_path.AppendChild(link["link_name"])
        eef_xform = UsdGeom.Xform.Define(stage, eef_path)
        eef_xform.SetResetXformStack(True)
        eef_xform.AddTranslateOp().Set(Gf.Vec3d(*offset))

        eef_prim = eef_xform.GetPrim()
        rigid_body = UsdPhysics.RigidBodyAPI.Apply(eef_prim)
        rigid_body.CreateRigidBodyEnabledAttr(True)
        UsdPhysics.MassAPI.Apply(eef_prim).CreateMassAttr(0.001)

        joint = UsdPhysics.FixedJoint.Define(stage, parent_sdf_path.AppendChild(f"{link['link_name']}_fixed_joint"))
        joint.CreateBody0Rel().SetTargets([parent_sdf_path])
        joint.CreateBody1Rel().SetTargets([eef_path])
        joint.CreateLocalPos0Attr(Gf.Vec3f(*offset))
        joint.CreateLocalPos1Attr(Gf.Vec3f(0.0, 0.0, 0.0))
        joint.CreateLocalRot0Attr(Gf.Quatf(1.0, Gf.Vec3f(0.0, 0.0, 0.0)))
        joint.CreateLocalRot1Attr(Gf.Quatf(1.0, Gf.Vec3f(0.0, 0.0, 0.0)))


def _find_urdf_link_name(root: ET.Element, suffix: str, fallback: str | None = None) -> str:
    for link in root.findall("link"):
        name = link.get("name")
        if name == suffix or (name is not None and name.endswith(f"_{suffix}")):
            return name
    if fallback is not None and root.find(f"./link[@name='{fallback}']") is not None:
        return fallback
    raise ValueError(f"Could not find URDF link ending in '{suffix}'.")


def _ensure_urdf_fixed_child_link(
    root: ET.Element,
    *,
    parent_link: str,
    child_link: str,
    joint_name: str,
    xyz: tuple[float, float, float],
) -> None:
    if root.find(f"./link[@name='{child_link}']") is None:
        ET.SubElement(root, "link", {"name": child_link})

    joint = root.find(f"./joint[@name='{joint_name}']")
    if joint is None:
        joint = ET.SubElement(root, "joint", {"name": joint_name, "type": "fixed"})
    else:
        joint.set("type", "fixed")

    for tag, link_name in (("parent", parent_link), ("child", child_link)):
        elem = joint.find(tag)
        if elem is None:
            elem = ET.SubElement(joint, tag)
        elem.set("link", link_name)

    origin = joint.find("origin")
    if origin is None:
        origin = ET.SubElement(joint, "origin")
    origin.set("xyz", f"{xyz[0]:g} {xyz[1]:g} {xyz[2]:g}")
    origin.set("rpy", "0 0 0")


def _patch_virtual_eef_links_into_urdf(urdf_path: str) -> None:
    """Add task-local fixed EEF links to Pink's generated URDF."""
    tree = ET.parse(urdf_path)
    root = tree.getroot()

    for link in _VIRTUAL_EEF_LINKS:
        _ensure_urdf_fixed_child_link(
            root,
            parent_link=_find_urdf_link_name(
                root,
                link["urdf_parent_link"],
                fallback=link["urdf_parent_fallback"],
            ),
            child_link=link["urdf_frame_name"],
            joint_name=f"{link['urdf_frame_name']}_fixed_joint",
            xyz=link["offset"],
        )

    ET.indent(tree, space="  ")
    tree.write(urdf_path, encoding="utf-8", xml_declaration=True)


@sim_utils.clone
def spawn_robot_with_virtual_eefs(
    prim_path: str,
    cfg: UsdFileCfg,
    translation: tuple[float, float, float] | None = None,
    orientation: tuple[float, float, float, float] | None = None,
    **kwargs,
):
    """Spawn the robot USD and add task-local fixed EEF bodies."""
    prim = sim_utils.spawn_from_usd(prim_path, cfg, translation=translation, orientation=orientation, **kwargs)
    _add_virtual_eef_links_to_stage(prim_path)
    return prim

